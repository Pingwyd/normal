# Supabase Auth and database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_JWT_AUD=authenticated

