# Supabase Auth and database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_JWT_AUD=authenticated

# Public visitor accounts (separate from Supabase Auth / admin_users)
ACCOUNT_JWT_SECRET=your-account-jwt-signing-secret
ACCOUNT_JWT_TTL_SECONDS=2592000

# Comma-separated browser origins allowed to call the API cross-origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: on-demand frontend cache revalidation after publish
# FRONTEND_REVALIDATE_URL=https://your-site.vercel.app/api/revalidate
# REVALIDATION_SECRET=your-revalidation-secret

# Resend (newsletter delivery)
# RESEND_API_KEY=your-resend-api-key
# NEWSLETTER_FROM_EMAIL=Normal <newsletter@your-domain.com>
# FRONTEND_BASE_URL=http://localhost:3000

# Web Push (VAPID keys for browser push delivery)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_CONTACT_EMAIL=mailto:push-admin@your-domain.com

# Encrypts founder-saved research provider API keys at rest (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RESEARCH_CREDENTIALS_ENCRYPTION_KEY=your-fernet-key
